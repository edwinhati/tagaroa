NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://tagaroa:tagaroa@127.0.0.1:5432/tagaroa
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:8080
# Every browser origin that may call this API. apps/auth runs on 3001.
TRUSTED_ORIGINS=http://localhost:8080,http://localhost:3001,http://localhost:3000,http://localhost:3002,http://localhost:3003
# WebAuthn. Comma-separated browser origins that may register or assert a
# passkey. Include the door (sign-in) and the workspace (Account settings).
# PASSKEY_ORIGIN remains accepted as a single-origin shorthand.
# Production requires explicit HTTPS TRUSTED_ORIGINS, PASSKEY_ORIGINS (or
# PASSKEY_ORIGIN) and PASSKEY_RP_ID. Passkey origins must be trusted and within
# the RP domain; development defaults below are rejected in production.
PASSKEY_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
PASSKEY_RP_ID=localhost

# --- Notifications ---------------------------------------------------------
# A channel sends as soon as it holds its credentials, in any environment; one
# without them writes to the log instead, so none of the credentials below are
# needed to run the repo. Production is the exception: there an unconfigured
# channel fails loudly rather than quietly logging.
#
# Setting RESEND_API_KEY and RESEND_FROM locally is therefore how the Resend
# carrier is exercised at all before it reaches production.
NOTIFICATION_WORKER=1
NOTIFICATION_DEFAULT_LOCALE=en
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_POLL_MS=2000
# NOTIFICATION_BATCH_SIZE=20
# Public URL of the provider webhooks. Twilio signs the URL it was configured
# with, so this must be the address Twilio actually calls, not an internal one.
# NOTIFICATION_WEBHOOK_URL=http://localhost:8080/api/notifications/webhooks

# Email. Set together or not at all.
# RESEND_API_KEY=
# RESEND_FROM=Tagaroa <no-reply@example.com>
# RESEND_WEBHOOK_SECRET=whsec_

# SMS. Set together or not at all.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550100

# WhatsApp. Business-initiated messages carry a Meta-approved template name,
# never free text, so a template row's body is that name.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

