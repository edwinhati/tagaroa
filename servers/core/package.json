{
  "name": "@servers/core",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "auth:schema": "bunx --bun auth generate --config ./src/modules/auth/auth.cli.ts --output ./src/modules/auth/infrastructure/persistence/drizzle/schema.ts --yes",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit && tsc -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "bun --watch --no-orphans src/main.ts",
    "security:preflight": "bun scripts/security-preflight.ts",
    "start": "bun src/main.ts",
    "start:e2e": "bun test/start-e2e.ts",
    "start:prod": "bun dist/main.js",
    "test": "bun test src",
    "test:integration": "bun test --isolate ./test/integration/*.integration.ts",
    "test:soak": "bun scripts/soak.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/drizzle": "0.0.2",
    "@nestjs/platform-express": "12.3.2",
    "@repo/contracts": "*",
    "@repo/email": "*",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/schematics": "12.0.12",
    "@repo/test-support": "*",
    "@repo/typescript-config": "*",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "auth": "1.7.12",
    "drizzle-kit": "0.31.11",
    "postgres": "3.4.9",
    "typescript": "7.0.2"
  }
}
