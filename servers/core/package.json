{
  "name": "@servers/core",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "auth:schema": "auth generate --config ./src/modules/auth/auth.cli.ts --output ./src/modules/auth/infrastructure/persistence/drizzle/schema.ts --yes",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "bun --watch --no-orphans src/main.ts",
    "start": "bun src/main.ts",
    "start:e2e": "bun test/start-e2e.ts",
    "start:prod": "bun dist/main.js",
    "test": "bun test src",
    "test:integration": "bun test ./test/integration/auth.integration.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@repo/narrow": "*",
    "@thallesp/nestjs-better-auth": "2.7.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/schematics": "12.0.0",
    "@repo/typescript-config": "*",
    "@types/bun": "1.4.0",
    "@types/node": "26.3.0",
    "auth": "1.7.2",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
