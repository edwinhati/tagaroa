{
  "name": "tagaroa",
  "private": true,
  "workspaces": [
    "apps/*",
    "domains/*",
    "packages/*",
    "servers/*"
  ],
  "scripts": {
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "prepare": "hk install",
    "test": "turbo run test",
    "test:e2e": "node scripts/test-playwright.mjs",
    "test:e2e:headed": "bun run test:e2e --headed --project=chromium",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "engines": {
    "bun": "1.4.2",
    "node": ">=24.15"
  },
  "knip": {
    "workspaces": {
      "apps/auth": {
        "entry": [
          "src/routes/**/*.tsx"
        ]
      },
      "servers/core": {
        "entry": [
          "src/modules/auth/auth.cli.ts"
        ]
      }
    }
  }
}
