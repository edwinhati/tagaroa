{
  "name": "tagaroa",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "domains/*",
      "packages/*",
      "servers/*"
    ],
    "catalog": {
      "@axe-core/playwright": "^4.14.0",
      "@better-auth/passkey": "1.7.12",
      "@fontsource-variable/geist": "^5.3.0",
      "@fontsource-variable/geist-mono": "^5.3.0",
      "@playwright/test": "1.64.1",
      "@ridemountainpig/svgl-react": "^1.0.18",
      "@tanstack/react-form": "1.33.5",
      "@tanstack/react-query": "5.105.0",
      "@tanstack/react-router": "1.170.46",
      "@tanstack/react-start": "1.169.4",
      "@tanstack/react-table": "^9.3.1",
      "@types/bun": "1.4.4",
      "@types/node": "26.6.6",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "better-auth": "1.7.12",
      "lucide-react": "^1.64.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "recharts": "3.10.1",
      "tailwindcss": "^4",
      "typescript": "7.0.2",
      "vite": "8.3.5",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "check-types": "turbo run check-types && bun run check-types:exploration",
    "check-types:exploration": "tsc --noEmit --strict --skipLibCheck --target es2023 --module esnext --moduleResolution bundler --types node --lib es2023,dom e2e.config.ts tests/exploration/*.e2e.ts",
    "check:infra": "bash scripts/ci/check-infra.sh",
    "dev": "turbo run dev",
    "explore": "E2E_TELEMETRY_DISABLED=1 e2e explore",
    "explore:headed": "bun run explore --headed",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "prepare": "[ -n \"$CI\" ] || hk install",
    "release:tag": "changeset git-tag",
    "release:version": "changeset version && bun install --lockfile-only",
    "test": "turbo run test",
    "test:e2e": "node scripts/test-playwright.mjs",
    "test:e2e:headed": "bun run test:e2e --headed --project=chromium",
    "test:exploration": "E2E_TELEMETRY_DISABLED=1 e2e run",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.81",
    "@changesets/cli": "3.0.3",
    "@e2e-dev/web": "0.15.3",
    "@repo/test-support": "*",
    "@shadcn/lint": "^0.2.3",
    "@types/node": "catalog:",
    "ai": "7.0.157",
    "e2e": "0.21.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "overrides": {
    "@react-email/render": "2.2.0",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "engines": {
    "bun": "1.4.4",
    "node": ">=24.15"
  },
  "knip": {
    "workspaces": {
      "apps/auth": {
        "entry": [
          "src/routes/**/*.tsx"
        ]
      },
      "servers/core": {
        "entry": [
          "src/modules/auth/auth.cli.ts"
        ]
      }
    }
  }
}
