{
  "name": "tagaroa",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "servers/*"
  ],
  "scripts": {
    "boundaries": "turbo boundaries",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "format": "oxfmt --check",
    "format:fix": "oxfmt .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "engines": {
    "bun": "1.4.0",
    "node": ">=24.15"
  },
  "knip": {
    "workspaces": {
      "apps/auth": {
        "entry": [
          "src/routes/**/*.tsx"
        ]
      },
      "servers/core": {
        "entry": [
          "src/modules/auth/auth.cli.ts"
        ]
      }
    }
  }
}
