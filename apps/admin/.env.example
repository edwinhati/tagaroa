# The door (`apps/auth`). An operator without a session is sent here, and comes
# back through its ?redirect= — so this app's origin must be listed in the door's
# VITE_TRUSTED_REDIRECT_ORIGINS or the hand-off is silently dropped.
VITE_AUTH_URL=http://localhost:3001

# The core service (`servers/core`) origin the session and /api/directory are
# read from. This origin must be in the core service's TRUSTED_ORIGINS.
VITE_AUTH_BASE_URL=http://localhost:8080

# The workspace, on its own origin: the way back out, and where a signed-in
# person without the admin role is sent.
VITE_WORKSPACE_URL=http://localhost:3000
