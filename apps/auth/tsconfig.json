{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "e2e",
    "playwright.config.ts",
    "playwright.deployed.config.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/impeccable"]
}
