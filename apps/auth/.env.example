# Leave unset in local dev: the Vite proxy makes `/api/auth` first-party so
# Brave/Safari keep the session cookie. Set this only when a reverse proxy
# already serves auth under the same site as this app.
# VITE_AUTH_BASE_URL=https://auth.example.com

# Where an operator lands after signing in, when the link carried no ?redirect=.
VITE_POST_SIGNIN_URL=http://localhost:3000

# The other workspace apps a ?redirect= may point at, comma separated. The origin
# above and this app's own are always allowed; anything else is ignored.
#
# The proxy (3000) and the back office (3003) are here; the shell's own port
# (3002) deliberately is not. The shell reached directly is off the proxy, where
# every domain path 404s, so a sign-in that started there should be corrected
# back to the proxy rather than handed back to the port it came from.
VITE_TRUSTED_REDIRECT_ORIGINS=http://localhost:3000,http://localhost:3003
