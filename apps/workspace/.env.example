# The door (`apps/auth`). An operator without a session is sent here, and comes
# back through its ?redirect=.
VITE_AUTH_URL=http://localhost:3001

# The core service (`servers/core`) origin the session is read from.
VITE_AUTH_BASE_URL=http://localhost:8080

# The admin back office, on its own origin. It is a standalone app, not a
# microfrontend, so the header links to it by URL rather than by path.
VITE_ADMIN_URL=http://localhost:3003
