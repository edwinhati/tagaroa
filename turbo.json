{
  "$schema": "./node_modules/turbo/schema.json",
  "futureFlags": {
    "globalConfiguration": true
  },
  "global": {
    "ui": "tui",
    "cacheMaxAge": "7d"
  },
  "tasks": {
    "transit": {
      "description": "No script runs this. It chains through ^transit so check-types and test hash their internal dependencies' sources without waiting for those packages' own runs.",
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "dependsOn": ["//#lint:fix"],
      "cache": false
    },
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["IMPECCABLE_*"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["TAGAROA_TEST_POSTGRES", "TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    }
  }
}
