#!/sbin/openrc-run
# OpenRC reads this variable.
# shellcheck disable=SC2034
description="ARM64 emulation for Tagaroa release builds"
depend() {
  need docker
  after localmount
}
start() {
  # Mount in the LXC's persistent namespace before the installer container.
  # Otherwise its registrations disappear when that container exits.
  mountpoint -q /proc/sys/fs/binfmt_misc || mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc || return 1
  docker run --privileged --rm \
    tonistiigi/binfmt@sha256:400a4873b838d1b89194d982c45e5fb3cda4593fbfd7e08a02e76b03b21166f0 \
    --install arm64
}
