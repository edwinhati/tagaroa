# Serves one app per image (infra/web/Dockerfile). Pangolin terminates TLS and
# routes each host to its own container, so plain HTTP on :80 and any Host.
# APP_PATH is the app's base path: empty for apps at a host's root,
# /engineering for that domain, which Pangolin sends app.<base>/engineering* to.
{
	auto_https off
	admin off
}

:80 {
	root * /srv
	# Brotli is precompressed at build time (infra/web/precompress.ts) and served
	# as is; encode covers clients without Brotli and files with no copy.
	encode zstd gzip
	# Nothing frames these apps, and admin must never be framed. The image writes
	# its inline-script hashes to /etc/caddy/csp (infra/web/inline-script-hashes.ts).
	# HSTS leaves out includeSubDomains until ops confirm every host is HTTPS.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' {file./etc/caddy/csp}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://{$BASE_DOMAIN}:*; frame-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Hashed build output: a missing one is a 404, never the app shell.
	handle {$APP_PATH}/assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br
		}
	}
	# TanStack Start's SPA mode emits _shell.html, not index.html.
	handle {
		header Cache-Control "no-store"
		try_files {path} {$APP_PATH}/_shell.html
		file_server {
			precompressed br
		}
	}
}
